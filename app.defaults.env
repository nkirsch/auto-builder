# Per-site settings and their defaults (upstream's own values). Forks don't
# edit this file: they override keys in app.env, which is read after it.
# Read by the Makefile and the ci/deploy workflows: KEY=value, unquoted
# (values may contain spaces), no shell syntax.
SITE_NAME=auto-builder
SITE_URL=https://builder.extreme.org
REPO=nkirsch/auto-builder
# Hugo builds the site at / (Dockerfile, Dockerfile.runner, CI).
HUGO_VERSION=0.147.3
# false: the image carries no site; the board sits behind a proxy (CloudFront).
SERVE_SITE=true
# push: deploy every push to master. release: deploy published releases only.
# none: never deploy (a fork with no infrastructure yet).
DEPLOY_ON=push
# off: don't import GitHub issues onto the board.
ISSUE_SYNC=on
# on: offer GitHub sign-in alongside Google. off (with Google configured):
# Google only, and a hub's GitHub sessions end; members can still connect
# their GitHub accounts (menu → Connect GitHub) when GITHUB_CLIENT_ID is set.
GITHUB_SIGN_IN=off
# The repo this one forks: an admin can keep up with it from the board's
# Admin page (upstream's own deploy ignores it, being that repo).
UPSTREAM=nkirsch/auto-builder
# A hub's New app page (e.g. https://extreme.org/new), linked as "Your app"
# for members; the hub's CREATORS_FROM decides who may use it.
CREATE_APP_URL=
# on: multi-tenant mode (TENANCY.md): deploy also builds the provision job's
# image; the service's TENANCY env comes from infra/tenancy.sh.
TENANCY=off
# Local Postgres for make db-up: one port and container per fork.
PG_PORT=5432
PG_NAME=auto-builder-pg
