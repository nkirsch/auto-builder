// A multi-tenant auto-builder hub (TENANCY=on) and the services it talks to.
// Render: dot -Tpng -Gdpi=150 docs/hub.dot -o docs/hub.png
digraph hub {
  graph [rankdir=LR, newrank=true, bgcolor="#0f1115", fontname="Helvetica Neue", fontcolor="#e6e6e6",
         pad=0.5, nodesep=0.3, ranksep=1.1, splines=spline, compound=true,
         label=<<b>auto-builder hub</b>   <font color="#7d8698" point-size="13">multi-tenant mode · what it talks to</font>>,
         labelloc=t, labeljust=l, fontsize=22];
  node  [shape=box, style="rounded,filled", fontname="Helvetica Neue", fontsize=12,
         color="#3a3f4b", fillcolor="#1b1f27", fontcolor="#e6e6e6", penwidth=1.2, margin="0.18,0.08"];
  edge  [color="#5d6577", fontname="Helvetica Neue", fontsize=10, fontcolor="#9aa3b5", arrowsize=0.7, penwidth=1.1];

  // ---- callers ----
  subgraph cluster_people {
    label="people"; style="rounded,dashed"; color="#3a3f4b"; fontcolor="#9aa3b5"; fontsize=13;
    members [label=<<b>members · admins</b><br/><font point-size="10" color="#9aa3b5">browser: boards · /admin/hubs</font>>];
  }

  subgraph cluster_mine_in {
    label="your services — calling in"; style="rounded,dashed"; color="#2b4a6e"; fontcolor="#9cc4f2"; fontsize=13;
    node [color="#4a90e2", fillcolor="#122236"];
    monitor    [label=<<b>status monitor</b><br/><font point-size="10" color="#9cc4f2">/health · /api/overview</font>>];
    widget [label=<<b>status widget</b><br/><font point-size="10" color="#9cc4f2">/api/overview</font>>];
    peers    [label=<<b>other hubs</b><br/><font point-size="10" color="#9cc4f2">HUBS → /api/overview</font>>];
  }

  // ---- the hub ----
  subgraph cluster_hub {
    label="hub  (Cloud Run, TENANCY=on)"; style="rounded"; color="#a35fc2"; fontcolor="#d6a8ea"; fontsize=13; penwidth=1.6;
    node [color="#a35fc2", fillcolor="#22172a"];
    server [label=<<font point-size="14"><b>builder server</b></font><br/><font point-size="10" color="#d6a8ea">boards /&lt;slug&gt;/ · /mcp · runner API<br/>/api/gate/tick · /api/overview · /api/tenants</font>>, penwidth=2];
    runner [label=<<b>runner job</b><br/><font point-size="10" color="#d6a8ea">claim → clone → claude -p /build-board</font>>];
    prov   [label=<<b>provision job</b><br/><font point-size="10" color="#d6a8ea">repo · service · accounts · DNS · log view</font>>];
    upjob  [label=<<b>upstream job</b><br/><font point-size="10" color="#d6a8ea">merge auto-builder → PR</font>>];
  }

  // ---- Google ----
  subgraph cluster_gcp {
    label="Google Cloud  (GCP_PROJECT)"; style="rounded,dashed"; color="#2f6b4a"; fontcolor="#7fd1a8"; fontsize=13;
    node [color="#2f8a5f", fillcolor="#13241c"];
    sql   [label=<<b>Cloud SQL Postgres</b><br/><font point-size="10" color="#7fd1a8">control + t_&lt;slug&gt; schemas</font>>];
    gcs   [label=<<b>Cloud Storage</b><br/><font point-size="10" color="#7fd1a8">attachments · run logs</font>>];
    runapi[label=<<b>Cloud Run Admin API</b><br/><font point-size="10" color="#7fd1a8">launch jobs</font>>];
    logs  [label=<<b>Cloud Logging</b><br/><font point-size="10" color="#7fd1a8">app request logs · 5xx/24h</font>>];
    sched [label=<<b>Cloud Scheduler</b><br/><font point-size="10" color="#7fd1a8">tick every 10 min</font>>];
    sm    [label=<<b>Secret Manager</b><br/><font point-size="10" color="#7fd1a8">tokens · keys → env</font>>];
    dns   [label=<<b>Cloud DNS · IAM</b><br/><font point-size="10" color="#7fd1a8">&lt;slug&gt; domain · app/deploy SAs</font>>];
  }
  subgraph cluster_gws {
    label="Google accounts"; style="rounded,dashed"; color="#2f6b4a"; fontcolor="#7fd1a8"; fontsize=13;
    node [color="#2f8a5f", fillcolor="#13241c"];
    goauth [label=<<b>Google OAuth</b><br/><font point-size="10" color="#7fd1a8">sign-in → members.email</font>>];
    gmail  [label=<<b>Gmail API</b><br/><font point-size="10" color="#7fd1a8">admin's mail: invites</font>>];
  }

  // ---- other third parties ----
  subgraph cluster_gh {
    label="GitHub"; style="rounded,dashed"; color="#3a3f4b"; fontcolor="#9aa3b5"; fontsize=13;
    ghapp  [label=<<b>GitHub App API</b><br/><font point-size="10" color="#9aa3b5">PRs · issues sync · compare · repos</font>>];
    ghoauth[label=<<b>GitHub OAuth</b><br/><font point-size="10" color="#9aa3b5">sign-in</font>>];
    gha    [label=<<b>Actions</b><br/><font point-size="10" color="#9aa3b5">CI · deploy.yml on release</font>>];
  }
  anthropic [label=<<b>Anthropic API</b><br/><font point-size="10" color="#e8b58f">Claude via Workload Identity Federation</font>>, color="#c96f3b", fillcolor="#2a1b12"];
  pushover  [label=<<b>Pushover</b><br/><font point-size="10" color="#9aa3b5">admin alerts</font>>];

  // ---- mine — called out ----
  subgraph cluster_mine_out {
    label="your services — called out"; style="rounded,dashed"; color="#2b4a6e"; fontcolor="#9cc4f2"; fontsize=13;
    node [color="#4a90e2", fillcolor="#122236"];
    apps   [label=<<b>tenant apps</b><br/><font point-size="10" color="#9cc4f2">&lt;slug&gt;.APP_DOMAIN<br/>GET /health {"sha"} → ship</font>>];
    signal [label=<<b>deploy notifier</b><br/><font point-size="10" color="#9cc4f2">deploy events</font>>];
  }

  { rank=same; members; monitor; widget; peers; }
  { rank=same; runner; prov; upjob; server; }

  // in
  members  -> server [label="HTTPS"];
  monitor    -> server [label="bearer STATS_TOKEN", color="#4a90e2"];
  widget -> server [label="bearer STATS_TOKEN", color="#4a90e2"];
  peers    -> server [label="STATS_TOKEN (both ways)", color="#4a90e2", dir=both];
  server   -> sched  [label="/api/gate/tick", color="#2f8a5f", dir=back];

  // hub internals
  server -> runapi [label="launch jobs", color="#a35fc2"];
  server -> runner [label="claim · /mcp · finish", color="#a35fc2", dir=back];

  // hub → Google
  server -> sql    [color="#2f8a5f"];
  server -> gcs    [color="#2f8a5f"];
  server -> logs   [label="errors_24h", color="#2f8a5f"];
  server -> sm     [label="env at deploy", style=dashed, color="#2f8a5f", dir=back];
  server -> goauth [color="#2f8a5f"];
  server -> gmail  [label="send", color="#2f8a5f"];
  prov   -> dns    [color="#2f8a5f"];

  // hub → third parties
  server -> ghapp   [label="App token"];
  server -> ghoauth;
  runner -> ghapp   [label="clone · branch · PR"];
  upjob  -> ghapp   [label="merge PR"];
  prov   -> ghapp   [label="repo from template"];
  runner -> anthropic [label="claude", color="#c96f3b", penwidth=1.6];
  server -> pushover;
  ghapp  -> gha     [style=dashed, label="merge"];

  // hub → mine
  server -> apps   [label="/health", color="#4a90e2", penwidth=1.6];
  gha    -> apps   [label="deploy", style=dashed];
  gha    -> signal [label="deploy.success / failure", style=dashed, color="#4a90e2"];
}
